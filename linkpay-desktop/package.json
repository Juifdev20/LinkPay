    "dist:store": "electron-builder --win appx"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}

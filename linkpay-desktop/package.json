{
  "name": "scanlinkpay-desktop",
  "productName": "ScanLinkPay",
  "version": "1.0.0",
  "description": "ScanLinkPay pour Windows — caisse, stock et paiements, avec impression directe sur les imprimantes de caisse.",
  "author": "ScanLinkPay",
  "private": true,
  "main": "src/main.js",
  "scripts": {

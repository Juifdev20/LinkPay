# LinkPay Android (Capacitor) build — overrides .env for `npm run build:android`.
# The WebView can't reach localhost, so this must point at the deployed API.

VITE_API_URL=https://linkpayapi.onrender.com/api/v1

# Public web URL used when building shareable links (payment requests, org
# pay pages) — window.location.origin inside the app is just Capacitor's
# internal WebView host, not a real address. See src/lib/share.ts.
VITE_PUBLIC_WEB_URL=https://linkpay-lwt2.onrender.com

# Supabase Realtime (anon key — safe to expose, protected by RLS)

# LinkPay Frontend Environment Variables
# Copy this file to .env and fill in your values

VITE_API_URL=http://localhost:3000/api/v1

# Public web URL used when building shareable links (payment requests, org
# pay pages) from inside the Android app — see src/lib/share.ts.
VITE_PUBLIC_WEB_URL=https://your-app.onrender.com

# Supabase Realtime (anon key — safe to expose, protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (VAPID) — public key only, safe to expose in the client build.
# Must match VAPID_PUBLIC_KEY on the backend. Generate both together with
# `npx web-push generate-vapid-keys` in linkpay-api.
VITE_VAPID_PUBLIC_KEY=

# Keep the session in HttpOnly cookies instead of browser storage (browser only; the Android app ignores it).
# Needs VITE_API_URL=/api/v1 with the web host proxying /api to the API (render.yaml), and COOKIE_AUTH=true on the API.
# See docs/COOKIES_HTTPONLY.md.
# VITE_AUTH_COOKIES=true

# Android app: Google Cloud project NUMBER linked to the app in the Play Console (device integrity check).
# VITE_PLAY_CLOUD_PROJECT_NUMBER=

.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# PWA generated assets (regenerated on build)
linkpay-web/dev-dist/

# Claude IDE artifacts
.claude/

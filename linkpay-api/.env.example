# ============================================
# LinkPay Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Public URL this API is reachable at — used to build the CinetPay notifyUrl
# (webhook) and other PSP callback URLs. On Render this falls back to the
# auto-populated RENDER_EXTERNAL_URL if left unset. Set explicitly for local
# tunneling (e.g. ngrok) to test real webhooks, or to override on any other
# host. No trailing slash.
BACKEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
# Long-lived on purpose ("remember me" like Facebook — closing the app never
# logs a user out on its own). The real session boundary is
# profiles.active_session_id, cleared only by explicit logout or an admin
# session reset, so this value just avoids the refresh token itself expiring
# a session first.
JWT_REFRESH_EXPIRES_IN=365d

# PSP Configuration
# PSP_PROVIDER=mock (default demo/dev mode) | flexpaie (Mobile Money RDC + carte, see docs/FLEXPAIE.md) | cinetpay (older)
PSP_PROVIDER=mock
PSP_SANDBOX=true
PSP_PUBLIC_KEY=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=
PSP_BASE_URL=

# FlexPaie (Infoset) — given with the merchant account. The token is a secret: only in Render, never in a chat or a file.
# Production: three addresses given by FlexPaie (Mobile Money, card, status check). Full addresses, as in their e-mail.
# FLEXPAIE_MOMO_URL=https://.../api/rest/v1/paymentService
# FLEXPAIE_CARD_URL=https://.../api/rest/v1/paymentService
# FLEXPAIE_CHECK_URL=https://apicheck.flexpaie.com/api/rest/v1/check   # with or without the /ORDER_NUMBER_A_REMPLACER end
# Test documentation: one host for everything (fallback for any of the three above that is not set)
# FLEXPAIE_BASE_URL=https://host:port      # no trailing slash; ask FlexPaie for an https address (the doc says http://ip:port)
# FLEXPAIE_MERCHANT=                       # the merchant code (e.g. ZANDO in their examples)
# CARD_PAYMENTS_ENABLED=true               # opens the bank card option for top-ups (FlexPaie), after a real card test
# FLEXPAIE_TOKEN=                          # the Authorization token (with or without the "Bearer " prefix)
# CinetPay (cinetpay.com) — Mobile Money RDC (Orange/Airtel/M-Pesa/Africell) + carte
# Nouvelle API CinetPay (sk_test_/sk_live_) — panel.cinetpay.net > Paramètres > Intégration API
CINETPAY_API_KEY_CD=
CINETPAY_API_PASSWORD_CD=

# Proxy for outbound HTTP requests (Render shared IPs need this for CinetPay IP whitelisting)
# Format: http://user:pass@proxy.example.com:port  (QuotaGuard, Fixie, etc.)
# Leave empty in local dev (only needed when your server IP isn't whitelisted by CinetPay)
PROXY_URL=

# Web Push (VAPID) — system-level push notifications even when the PWA is
# closed. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: contact required by the Web Push protocol (push services use it to
# reach you if your server is misbehaving/sending too much traffic).
VAPID_SUBJECT=mailto:contact@example.com

# Firebase Cloud Messaging — native push for the Capacitor Android app (its
# WebView can't receive Web Push). From the Firebase service account key
# JSON (Project Settings > Service Accounts > Generate new private key):
# project_id, client_email, and private_key (keep its literal \n sequences).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
WEBHOOK_REPLAY_WINDOW=300

# Logging
LOG_LEVEL=debug

# Number of reverse proxies in front of the API (Render = 1). Defaults to 1 in production, 0 elsewhere.
# Needed so the rate limiter sees each client's real IP instead of the proxy's.
# TRUST_PROXY_HOPS=1

# The interactive API docs (/api/v1/docs) are off in production unless this is true.
# ENABLE_SWAGGER=false

# Administrators (admin / super_admin) log in with an authenticator-app code.
# Key that encrypts the stored 2FA secrets (defaults to a key derived from JWT_SECRET — set your own, 32+ random chars,
# and never change it afterwards or every admin must set 2FA up again).
# TWO_FACTOR_ENCRYPTION_KEY=
# Admin refresh tokens live 12h by default instead of a year.
# ADMIN_REFRESH_EXPIRES_IN=12h
# Optional: admin accounts only work from these IPs (comma-separated). Leave unset if admins connect from mobile data.
# ADMIN_ALLOWED_IPS=

# Critical security alerts are also emailed (https://resend.com — free tier is enough).
# The sender must be on a domain you verified in Resend. Leave RESEND_API_KEY unset to disable.
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=ScanLinkPay Alertes <alertes@votre-domaine.com>
# Extra recipients on top of the super admins' own addresses (comma-separated).
# ALERT_EMAILS=

# Critical security alerts are also sent by SMS (short text, nothing confidential in it) to the super admins' phone
# numbers (their profile phone, international format +243…) and to ALERT_SMS_TO. Pick ONE provider:
#   Africa's Talking (https://africastalking.com — good coverage in the DRC; username "sandbox" = test mode)
# SMS_PROVIDER=africastalking
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
#   or Twilio (https://twilio.com)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# ALERT_SMS_TO=+243XXXXXXXXX,+243YYYYYYYYY
# Spending brake: at most this many alert SMS per hour per API instance (default 10).
# SMS_MAX_PER_HOUR=10

# Secret mixed into the access code before it is hashed, so a leaked database copy can't be brute-forced
# (defaults to a key derived from JWT_SECRET). Set 32+ random chars and never change it afterwards, or every
# user will have to choose a new access code.
# APP_CODE_PEPPER=

# --- Several API instances -------------------------------------------------------------------------------------------
# Shared rate-limit counters (otherwise each instance counts on its own). Render: add a Key Value (Redis) service and
# paste its internal connection string. Unset = in-memory counters, fine for a single instance. If Redis goes down the API
# keeps working with per-instance counters. Scheduled jobs are locked in the database (migration 053), nothing to set.
# REDIS_URL=redis://red-xxxxxxxx:6379

# --- Session tokens in HttpOnly cookies (browsers only; see docs/COOKIES_HTTPONLY.md before turning on) ----------------
# Needs the web app and the API on the SAME SITE (e.g. the web app proxies /api to the API, or app. and api. subdomains)
# and the web app built with VITE_AUTH_COOKIES=true. The Android app keeps using the Authorization header.
# COOKIE_AUTH=true
# COOKIE_SAMESITE=strict      # strict (default) | lax | none (cross-site, weaker: avoid)
# COOKIE_DOMAIN=              # only to share the cookie between subdomains, e.g. .scanlinkpay.com

# --- Android device and app integrity (Google Play Integrity; see docs/ANDROID_INTEGRITY.md) ---------------------------
# off (default): record only · warn: + alert admins when a phone is rooted/emulated/repackaged · enforce: such a phone
# (and an Android-app session without a recent verdict) can't send money or withdraw.
# DEVICE_INTEGRITY_MODE=off
# ANDROID_PACKAGE_NAME=com.scanlinkpay.app
# SHA-256 of OUR signing certificate(s), comma-separated (Play Console > App integrity, or keytool -list -v)
# ANDROID_CERT_SHA256=
# Service account (Google Cloud project linked to the app) allowed to decode integrity tokens
# PLAY_INTEGRITY_CLIENT_EMAIL=
# PLAY_INTEGRITY_PRIVATE_KEY=
# false = also accept APKs not installed from Google Play (weaker)
# INTEGRITY_REQUIRE_PLAY_RECOGNIZED=true
# How long a "trusted" verdict stays valid before the app must verify again (hours)
# INTEGRITY_MAX_AGE_HOURS=24

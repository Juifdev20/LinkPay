# ============================================
# LinkPay Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
# Long-lived on purpose ("remember me" like Facebook — closing the app never
# logs a user out on its own). The real session boundary is
# profiles.active_session_id, cleared only by explicit logout or an admin
# session reset, so this value just avoids the refresh token itself expiring
# a session first.
JWT_REFRESH_EXPIRES_IN=365d

# PSP Configuration
# PSP_PROVIDER=mock (default demo/dev mode) | cinetpay (real Mobile Money RDC + carte)
PSP_PROVIDER=mock
PSP_SANDBOX=true
PSP_PUBLIC_KEY=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=
PSP_BASE_URL=

# CinetPay (cinetpay.com) — Mobile Money RDC (Orange/Airtel/M-Pesa/Africell) + carte
# Nouvelle API CinetPay (sk_test_/sk_live_) — panel.cinetpay.net > Paramètres > Intégration API
CINETPAY_API_KEY_CD=
CINETPAY_API_PASSWORD_CD=

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
WEBHOOK_REPLAY_WINDOW=300

# Logging
LOG_LEVEL=debug

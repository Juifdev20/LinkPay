# ============================================
# LinkPay Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Public URL this API is reachable at — used to build the CinetPay notifyUrl
# (webhook) and other PSP callback URLs. On Render this falls back to the
# auto-populated RENDER_EXTERNAL_URL if left unset. Set explicitly for local
# tunneling (e.g. ngrok) to test real webhooks, or to override on any other
# host. No trailing slash.
BACKEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
# Long-lived on purpose ("remember me" like Facebook — closing the app never
# logs a user out on its own). The real session boundary is
# profiles.active_session_id, cleared only by explicit logout or an admin
# session reset, so this value just avoids the refresh token itself expiring
# a session first.
JWT_REFRESH_EXPIRES_IN=365d

# PSP Configuration
# PSP_PROVIDER=mock (default demo/dev mode) | cinetpay (real Mobile Money RDC + carte)
PSP_PROVIDER=mock
PSP_SANDBOX=true
PSP_PUBLIC_KEY=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=
PSP_BASE_URL=

# CinetPay (cinetpay.com) — Mobile Money RDC (Orange/Airtel/M-Pesa/Africell) + carte
# Nouvelle API CinetPay (sk_test_/sk_live_) — panel.cinetpay.net > Paramètres > Intégration API
CINETPAY_API_KEY_CD=
CINETPAY_API_PASSWORD_CD=

# Proxy for outbound HTTP requests (Render shared IPs need this for CinetPay IP whitelisting)
# Format: http://user:pass@proxy.example.com:port  (QuotaGuard, Fixie, etc.)
# Leave empty in local dev (only needed when your server IP isn't whitelisted by CinetPay)
PROXY_URL=

# Web Push (VAPID) — system-level push notifications even when the PWA is
# closed. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: contact required by the Web Push protocol (push services use it to
# reach you if your server is misbehaving/sending too much traffic).
VAPID_SUBJECT=mailto:contact@example.com

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
WEBHOOK_REPLAY_WINDOW=300

# Logging
LOG_LEVEL=debug
